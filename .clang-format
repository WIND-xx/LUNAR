# ==============================================================
# .clang-format — LUNAR BSP 代码风格 (K&R + 嵌入式 C)
# 基于 clang-format 12+
# ==============================================================

Language: Cpp
Standard: c++11

# ---- 基础风格 (LLVM 为底) ----
BasedOnStyle: LLVM

# ==============================================================
# 1. 缩进 (4空格, 禁用Tab)
# ==============================================================
IndentWidth: 4
TabWidth: 4
UseTab: Never
IndentPPDirectives: None
IndentCaseLabels: false
IndentCaseBlocks: false
IndentGotoLabels: false
NamespaceIndentation: None

# ==============================================================
# 2. 大括号 — K&R (函数也不换行)
# ==============================================================
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel:  false
  AfterClass:      false
  AfterEnum:       false
  AfterFunction:   false   # K&R: 函数大括号不换行
  AfterNamespace:  false
  AfterStruct:     false
  AfterUnion:      false
  AfterExternBlock: false
  BeforeCatch:     false
  BeforeElse:      false
  BeforeLambdaBody: false
  BeforeWhile:     false
  IndentBraces:    false

# ==============================================================
# 3. 短语句 — 允许简洁单行
# ==============================================================
AllowShortBlocksOnASingleLine: true    # if (x) { return; }
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline  # 仅 inline 函数可单行
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true     # for (;;) { single; }
AllowShortEnumsOnASingleLine: true
AllowShortLambdasOnASingleLine: All

# ==============================================================
# 4. 每行字符数
# ==============================================================
ColumnLimit: 120

# ==============================================================
# 5. 空格规则
# ==============================================================
PointerAlignment: Left           # Type* ptr
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements  # if ( ... )
SpaceInEmptyParentheses: false
SpaceAfterCStyleCast: false
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInConditionalStatement: false
SpacesInContainerLiterals: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesBeforeTrailingComments: 2   # 尾注释前 2 空格

# ==============================================================
# 6. 对齐
# ==============================================================
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignEscapedNewlines: Left
AlignOperands: true
AlignTrailingComments: true

# ==============================================================
# 7. 换行
# ==============================================================
AlwaysBreakBeforeMultilineStrings: false
BinPackArguments: true
BinPackParameters: true
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: false
BreakStringLiterals: true
ContinuationIndentWidth: 4

# ==============================================================
# 8. 注释 & include
# ==============================================================
ReflowComments: false
SortIncludes: false           # 嵌入式项目 include 顺序人工控制
IncludeBlocks: Preserve
FixNamespaceComments: true

# ==============================================================
# 9. 其他
# ==============================================================
MaxEmptyLinesToKeep: 2
AlignConsecutiveMacros: false      # 不破坏寄存器定义格式
AlignConsecutiveBitFields: false
DerivePointerAlignment: false
Cpp11BracedListStyle: true
ConstructorInitializerAllOnOneLineOrOnePerLine: true
ConstructorInitializerIndentWidth: 4

# Qt / 嵌入式语句宏
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION
