# 基于 LLVM，作为起点
BasedOnStyle: LLVM

# 通用
Language: Cpp
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120

# 括号风格：
# - 函数定义的大括号单独一行
# - if/for/while/switch 等控制语句的大括号与语句在同一行
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true        # void func()\n{
  AfterClass: false
  AfterStruct: false
  AfterControlStatement: false  # if (cond) {
  AfterEnum: false
  BeforeElse: false
  BeforeCatch: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# 对齐与空格（结合文档中的示例）
SpaceBeforeParens: ControlStatements   # if (cond) / for ( ... )
SpaceBeforeRangeBasedForLoopColon: true
SpaceAroundPointerQualifiers: Default
PointerAlignment: Left                 # Type* ptr

# 允许在乘除号两侧省略空格（clang-format 无法精确按“有时省略”，这里保持默认）
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceInEmptyParentheses: false
SpacesInCStyleCastParentheses: false

# 不强制把短函数写成一行，便于保持示例中的风格
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# 命名、注释等由人工遵守，clang-format 不做强制